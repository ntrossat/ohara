# Public address of this Ohara instance, without a trailing slash.
# It can include a path, such as https://acme.com/docs, to serve Ohara there.
# GitHub sends people and webhooks back to it.
OHARA_URL=http://localhost:8000

# Where Ohara keeps its data: the docs snapshot and the ohara.db database. Defaults to /data,
# the Docker volume. Set it for a local run outside Docker, such as OHARA_DATA_DIR=.data.
# OHARA_DATA_DIR=/data

# Where the built React app lives. Defaults to ohara/static next to the backend package,
# where the Docker image puts it. Rarely needed.
# OHARA_STATIC_DIR=

# Locks setup to the link OHARA_URL/api/setup/start?token=<this value>, so nobody else can claim a new instance
# before its admin. For hosts that create instances for others. Leave unset to set Ohara up from the setup page.
# OHARA_SETUP_TOKEN=
